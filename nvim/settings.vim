" SETTINGS**********************************************************************

filetype plugin indent on
filetype plugin on
set syntax=on
syntax enable
set encoding=UTF-8
set number relativenumber
set colorcolumn=80
set signcolumn=yes
set title
set incsearch
set ignorecase
set smartcase
set smartindent
set autoindent
set noshowmode
set showmatch
