snippet figure
\begin{figure}[H]
	\centering
	\includegraphics[scale=]{ImageName}
	\caption{\centering Caption}
	\label{fig_num}
\end{figure}
endsnippet

snippet multipleFigure
\begin{figure}[H]
  \centering
  \begin{subfigure}[a]{0.45\linewidth}
    \centering
    \includegraphics[scale=0.17]{Fig1}
    \caption{\centering Caption 1}
    \label{l1}
  \end{subfigure}
  \begin{subfigure}[a]{0.45\linewidth}
    \centering
    \includegraphics[scale=0.17]{Fig2}
    \caption{\centering Caption 2}
    \label{l2}
  \end{subfigure}
  \caption{\centering General caption}
  \label{label}
\end{figure}
endsnippet

