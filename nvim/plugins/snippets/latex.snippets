snippet graphic
\begin{figure}[H]
  \centering
  \begin{tikzpicture}[scale=1]
    \begin{axis}[xmin=-3,xmax=3,ymin=-2,ymax=2,
      xmajorgrids=true, ymajorgrids=true, axis lines=center,
      ylabel=$y$, ylabel style={above right},
      xlabel=$x$, xlabel style={above right}]
      \addplot[mark=*,blue] coordinates {
        (0,0)
      };
    \end{axis}
  \end{tikzpicture}
  \caption{\centering Nombre del gráfico}
\end{figure}
endsnippet

snippet tcolorbox
\begin{tcolorbox}[width=85 mm,colback=white!100!white,
  colframe=black!75!gray,fonttitle=\bfseries,
  title=Box_title]
  \vspace{-1 mm}
  \begin{equation}
    \therefore GDL=2
  \end{equation}
  Texto.
\end{tcolorbox}
endsnippet

snippet graphdot
\addplot[cyan,mark=*]plot coordinates{(0,0)};
endsnippet
snippet grapharrow
\draw[thick,blue,->] (0,0)--(1,1);
endsnippet
snippet graphsegment
\addplot[cyan]plot coordinates{(0,0)(0,3)};
endsnippet
snippet graphfunction
\draw[color=cyan,samples=100,domain=0:3] plot (\x,{\x});
endsnippet
snippet grapharea
\filldraw[draw=cyan,fill=cyan,opacity=0.4] (0,0)--(1,1)--(2,0)--cycle;
endsnippet
