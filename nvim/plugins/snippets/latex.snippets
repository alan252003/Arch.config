snippet 3dplot
\begin{figure}[ht!]
  \centering
  \tdplotsetmaincoords{70}{120}
    \begin{tikzpicture}
      \begin{axis}[width=10cm,
        xmin=-5,xmax=5,
        ymin=-5,ymax=5,
        zmin=0,zmax=10,
        % axis lines=center
        ]
        \addplot3[mesh,surf,domain=:]{};
      \end{axis}
    \end{tikzpicture}
  \caption{Robot manipulador de 2 grados de libertad}
\end{figure}
endsnippet

snippet circuitdiagram
\begin{figure}[H]
  \centering
  \begin{circuitikz}[american,cute inductors,scale=1]
  	\ctikzset{label/align=rotate}
  \end{circuitikz}
  \caption{\centering Electric circuit diagram}
  \label{electric_fig}
\end{figure}
endsnippet
snippet circle "Draw a circle for a circuitikz environment"
\node (ID) at (,) [circle,draw=black,minimum size=1cm,fill=none,text=black,font=\normal]{text};
endsnippet
snippet square "Draw a square for a circuitikz environment"
\node (ID) at (,) [rectangle,draw=black,minimum size=1cm,fill=white,rounded corners=0.1cm,rotate=0,text=black,font=\normal]{text};
endsnippet
snippet rectangle "Draw a rectangle for a circuitikz environment"
\node (ID) at (,) [rectangle,draw=black,minimum width=1cm,minimum height=1cm,fill=white,rounded corners=0.1cm,rotate=0,text=black,font=\normal]{text};
endsnippet
snippet ellipse "Draw a ellipse for a circuitikz environment"
\node (ID) at (,) [ellipse,draw=black,minimum size=1cm,fill=white,rotate=0,text=black,font=\normal]{};
endsnippet
snippet link "Draw a link between nodes through a line with edges, an initial and a final degree, and the value of how smooth is going to be the line"
\draw[<->,>=latex,line width=1pt,color=black] (ID1) to[out=0, in=180, looseness=1.5] (ID2);
endsnippet
snippet arc "Draw an arc of circumference for a circuitikz environment"
arc (d0:d1:r)
endsnippet

