snippet keyboardMatrix
% Teclado
\draw (-7,3)--(-7,5)--(-2,5)--(-2,-1.5)--(-7,-1.5)--cycle;
\draw (-3,4) node[]{$\ast$} circle (5mm);
\draw (-4.5,4) node[]{0} circle (5mm);
\draw (-6,4) node[]{\#} circle (5mm);
\draw (-3,2.5) node[]{7} circle (5mm);
\draw (-4.5,2.5) node[]{8} circle (5mm);
\draw (-6,2.5) node[]{9} circle (5mm);
\draw (-3,1) node[]{4} circle (5mm);
\draw (-4.5,1) node[]{5} circle (5mm);
\draw (-6,1) node[]{6} circle (5mm);
\draw (-3,-.5) node[]{1} circle (5mm);
\draw (-4.5,-.5) node[]{2} circle (5mm);
\draw (-6,-.5) node[]{3} circle (5mm);
\draw (-2,4) node[above right]{\scriptsize{D}} to (0,4);
\draw (-2,2.5) node[above right]{\scriptsize{C}} to (0,2.5);
\draw (-2,1) node[above right]{\scriptsize{B}} to (0,1);
\draw (-2,-.5) node[above right]{\scriptsize{A}} to (0,-.5);
\draw (-6,-1.5) node[below right]{\scriptsize{3}} to[short,-o] (-6,-2.5) node[below]{\scriptsize{$Col_{3}$}};
\draw (-4.5,-1.5) node[below right]{\scriptsize{2}} to[short,-o] (-4.5,-2.5) node[below]{\scriptsize{$Col_{2}$}};
\draw (-3,-1.5) node[below right]{\scriptsize{1}} to[short,-o] (-3,-2.5) node[below]{\scriptsize{$Col_{1}$}};
endsnippet


